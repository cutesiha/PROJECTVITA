# PROJECT VITA .gitattributes
# Git LFS는 쓰지 않는다 (Docs/Dev/01_프로젝트환경구축.md 4-1). 레포가 1GB에 가까워지면 다시 검토한다.

* text=auto

# 대사와 데이터 (작가가 Windows에서 편집해도 LF로 저장)
*.yarn          text eol=lf
*.yarnproject   text eol=lf
*.csv           text eol=lf
*.md            text eol=lf
*.json          text eol=lf

# 코드
*.cs            text eol=lf diff=csharp
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.shader        text eol=lf
*.hlsl          text eol=lf
*.cginc         text eol=lf
*.uss           text eol=lf
*.uxml          text eol=lf
*.inputactions  text eol=lf

# Unity YAML
[attr]unity-yaml text eol=lf merge=unityyamlmerge
*.unity             unity-yaml
*.prefab            unity-yaml
*.asset             unity-yaml
*.meta              unity-yaml
*.mat               unity-yaml
*.anim              unity-yaml
*.controller        unity-yaml
*.overrideController unity-yaml
*.physicsMaterial2D unity-yaml
*.playable          unity-yaml
*.mixer             unity-yaml
*.preset            unity-yaml
*.spriteatlas       unity-yaml
*.spriteatlasv2     unity-yaml
*.scenetemplate     unity-yaml
*.renderTexture     unity-yaml
*.signal            unity-yaml
*.lighting          unity-yaml
LightingData.asset  binary

